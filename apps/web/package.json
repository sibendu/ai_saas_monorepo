{
  "name": "@saas/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/next-with-root-env.js dev",
    "build": "node scripts/next-with-root-env.js build",
    "start": "node scripts/next-with-root-env.js start",
    "start:with-db": "node scripts/start-with-db.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --passWithNoTests unit.test",
    "test:integration": "vitest run --passWithNoTests integration.test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "verify:tailwind-theme": "node scripts/verify-tailwind-theme.js",
    "db:seed": "node prisma/seed.js",
    "db:generate": "node prisma/run-prisma.js generate",
    "db:push": "node prisma/run-prisma.js db push",
    "db:deploy": "node prisma/run-prisma.js migrate deploy",
    "db:validate": "node prisma/run-prisma.js validate",
    "db:setup": "node prisma/bootstrap.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@saas/shared-types": "*",
    "bcryptjs": "^3.0.3",
    "dotenv": "16.6.1",
    "next": "^16.1.6",
    "next-auth": "^4.24.5",
    "nodemailer": "^7.0.13",
    "pg": "^8.18.0",
    "prisma": "6.19.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "whatwg-fetch": "^3.6.20"
  }
}
