# Copy this file to .env.local and fill in the values for your environment.

# Display settings
APP_NAME=SaaS Platform
STYLE=default
MENU_LAYOUT=left

# Application URLs
WEB_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_BFF_URL=http://localhost:3001
BFF_INTERNAL_URL=http://localhost:3001

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GITHUB_ID=
GITHUB_SECRET=

# Email (optional; activation and reset links are logged locally when omitted)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM=

# SQLite demo mode
DB_PROVIDER=sqlite
DATABASE_URL=file:../data/demo.db
DB_BOOTSTRAP_ON_START=true
DB_SEED_ON_START=true

# PostgreSQL production/development alternative
# DB_PROVIDER=postgresql
# DATABASE_URL=postgresql://username:password@localhost:5432/saasdb
# DB_BOOTSTRAP_ON_START=false
# DB_SEED_ON_START=false

# Redis (optional)
# REDIS_URL=redis://localhost:6379
